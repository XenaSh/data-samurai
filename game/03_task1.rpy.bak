screen d_column_hunt():
    modal True
    zorder 50
    default picked = set()

    for i in range(12):
        button:
            xpos 1137
            ypos 113 + 50 * i
            xsize 216
            ysize 46
            background (Solid("#00ffcc77") if i in picked else None)
            hover_background Solid("#00ffcc33")
            action ToggleSetMembership(picked, i)

    frame:
        xalign 0.5
        ypos 740
        padding (24, 14)
        background Solid("#0a0f1acc")
        vbox:
            spacing 10
            xalign 0.5
            text "Кликни по ячейкам D, которые выбиваются" color "#00ffcc" size 22 xalign 0.5
            hbox:
                spacing 24
                xalign 0.5
                textbutton "Показать боссу" action Return(sorted(picked)) sensitive len(picked) > 0
                textbutton "Ничего не вижу" action Return([])

screen d_spikes_reveal():
    zorder 40
    for i in (2, 9):
        frame:
            xpos 1137
            ypos 113 + 50 * i
            xsize 216
            ysize 46
            padding (0, 0)
            background Solid("#ffaa0077")
image ill_delay = "images/illustrations/ill_delay.png"
image ill_loss = "images/illustrations/ill_loss.png"
image ill_dup = "images/illustrations/ill_dup.png"
image ill_burst = "images/illustrations/ill_burst.png"

default mech_solved = []
default mech_hits = 0
default mech_layout = ["delay", "loss", "dup", "burst"]

define mech_names = {
    "delay": "Задержка",
    "loss": "Потеря",
    "dup": "Дублирование",
    "burst": "Залповый сброс",
}

define mech_wrong = {
    "delay": "Стоп, не на ту нажал. Рука впереди головы, бывает. Картинка с часами про чек, который всё-таки добрался до сервера, просто опоздал. А я рассказывал про другое: там чек либо не дошёл вообще, либо пришёл не один, либо влетел в сервер вместе с целой очередью. Правильная картинка теперь подписана.",
    "loss": "Стоп, не на ту нажал. Красный крест это про чек, который не дошёл вовсе: деньги в кассе есть, строчки в отчёте нет. А в моём рассказе чек до сервера добирался, просто опоздавший, повторный или в толпе других. Правильная картинка теперь подписана.",
    "dup": "Стоп, не на ту нажал. Раздвоившийся чек про одну продажу, которая попала в отчёт дважды. А я рассказывал про другое: там чек либо опоздал, либо пропал, либо прилетел вместе с накопившейся очередью. Правильная картинка теперь подписана.",
    "burst": "Стоп, не на ту нажал. Воронка с кучей чеков про очередь, которая прилетает на сервер разом. А я рассказывал про одиночный чек, который опоздал, пропал или размножился. Правильная картинка теперь подписана.",
}

screen mech_board_view(solved):
    zorder 40
    for idx, key in enumerate(mech_layout):
        $ done = key in solved
        fixed:
            xpos 60 + idx * 460
            ypos 30
            xsize 420
            ysize 670
            add (Solid("#00ffcc22") if done else Solid("#0a0f1acc")) xsize 420 ysize 600
            add ("ill_" + key) at Transform(fit="contain", size=(400, 570)) xalign 0.5 ypos 15
            if done:
                frame:
                    xalign 0.5
                    ypos 612
                    padding (18, 6)
                    background Solid("#0a0f1aee")
                    text mech_names[key] color "#ffaa00" size 24 outlines [(2, "#000000", 0, 0)]

screen mech_pick(solved):
    zorder 41
    modal True
    for idx, key in enumerate(mech_layout):
        if key not in solved:
            button:
                xpos 60 + idx * 460
                ypos 30
                xsize 420
                ysize 600
                background None
                hover_background Solid("#00ffcc33")
                action Return(key)

label mech_round(correct):
    window hide
    call screen mech_pick(mech_solved)
    $ picked = _return
    $ mech_solved.append(correct)
    show screen mech_board_view(mech_solved)
    window show
    if picked == correct:
        $ mech_hits += 1
        $ accuracy += 1
    else:
        $ wrong_line = mech_wrong[picked]
        player "[wrong_line]"
    return



label tasks_from_boss:
    window show
    hide screen desktop
    hide screen investigation_bar
    scene bg_terminal

    if current_task == 1:
        jump task1
    elif current_task == 2:
        jump task2
    elif current_task == 3:
        jump task3
    else:
        boss "Все задания выполнены. Отдыхай."
        jump desktop_loop


label task1:
    window show
    hide screen desktop
    hide screen investigation_bar
    scene bg_task1_briefing with dissolve
    with dissolve

    boss "Дошёл до рабочего места всё-таки."
    boss "Думаю, тебе известно, в чем дело. Если ещё нет, то ты здесь, чтобы расследовать аномалию. Закончишь и я тебя отпущу дальше глядеть на звёзды."
    boss "Таблица показателей по пяти магазинам за три месяца."
    "Всё твоё тело напряглось — кажется, сейчас в тебя просто бросят заданием без всяких прелюдий."
    boss "Все данные идут через один центральный сервер сети — кассы, трафик, всё завязано на нём."

    show image "images/task1_table.png" at Transform(fit="contain", size=(1920, 700)):
        xalign 0.5
        yalign 0.05

    "Ты резко переключаешься из режима непонимания на режим аналитики. Ты чувствуешь, что это тебе привычно — ты часто вот так оставлял реальность за дверью."
    "Пускай останутся только данные, а весь мир подождёт."
    "Ты пытаешься выцепить в числах хоть что-то интересное."
    "Первым делом ты видишь, что данные анонимизированные — вместо ID магазинов или их адресов всего лишь буквы. Каждой букве соответствует строка с показателями."
    "«Странно, обычно для внутренних аналитиков данные не анонимизируют. Так делают, когда хотят скормить таблицу внешней нейросети, но не переживать за конфиденциальность», — думаешь ты."
    "«Может быть, дело в Саше?»"
    player "Средняя выручка, продажи, средний чек — все пятеро подозрительно похожи. Как братья, которых заставили сфотографироваться в одинаковых свитерах. Без дополнительных данных это пальцем в небо!"
    boss "И тем не менее..."


    window hide
    menu:
        "Магазин A":
            $ task1_store_picked = "A"
            window show
            boss "Смотрю на данные по A. Ничего для меня не значат, если честно."
            player "Скучно. Аномалии тут явно не место."

            jump task1_question1

        "Магазин B":
            $ task1_store_picked = "B"
            window show
            boss "B. Тут я не понимаю, на что смотреть."
            player "На то, как я играю в дата-рулетку."

            jump task1_question1

        "Магазин C":
            $ task1_store_picked = "C"
            window show
            boss "C. Цифры вроде крупные. Это плохо?"
            player "Высокие цифры и аномалия — не синонимы. Нужен иной подход..."
            player "Но вы мне решительно ничего не предоставили."
            jump task1_question1

        "Магазин D":
            $ task1_store_picked = "D"
            window show
            boss "D. Как и все остальные — просто набор цифр, ничего явного я тут не вижу."
            $ intuition += 10
            player "В среднем D как все. Но «в среднем» — то самое слово, которому я сегодня не доверяю."

            jump task1_question1

        "Магазин E":
            $ task1_store_picked = "E"
            window show
            boss "E. То же самое, что и остальные — я не вижу разницы."
            player "Да и я тоже."

            jump task1_question1


label task1_question1:
    window show
    "Тебе неуютно от недостатка вводных."
    player "Так не пойдёт. Это не расследование, а абсурд."
    "Ты стряхиваешь бесполезные числа со своего сознания."
    hide image "images/task1_table.png"
    player "По этой таблице нельзя понять, где аномалия. Мне не хватает данных для честного вывода."
    $ news_list.extend([
        "Депутат предложил утвердить шестидневную рабочую неделю, так как 'среда это же середина'.",
        "Акции производителей фольги взлетели на 200% после заявления президента Остазии.",
        "Статистики в шоке: средняя зарплата выросла, а выживших стало меньше."
    ])
    $ unread_news = True
    $ unlock_memory("stroka_4817")
    boss "Допустим..."
    boss "Если средние не показывают аномалию — чего не хватает для правильного вывода?"
    window hide
    menu:
        "Мне нужны сырые данные по дням, а не средние, где всё слито в одно число.":
            $ task1_route = "raw_data"
            window show
            boss "Допустим, я дам тебе данные по дням. Что ты будешь с ними делать такого, чего не даёт эта таблица?"
            player "Сырые данные на то и сырые. Могу сделать с ними вообще всё."
            boss "У меня нет времени смотреть, как ты делаешь «всё». Делай то, что поможет тебе найти аномальный магазин."
            player "Посмотрю... на сами цифры. На то, как они меняются день ото дня."
            boss "И как именно ты поймёшь, что «меняются слишком сильно и аномально», а не просто «меняются»?"
            player "...Мне нужно с чем-то сравнить это изменение. Число, которое покажет, насколько сильно данные скачут вокруг среднего."
            player "Стандартное отклонение. Вот что я хочу увидеть на самом деле."
            $ accuracy += 6

            jump task1_std_how

        "Нужны графики — визуально проще заметить аномалии.":
            $ task1_route = "graphs"
            window show
            boss "Графики чего? У тебя пять чисел на магазин. Нарисуй мне график по этой таблице — что на нём изменится?"
            player "...Ничего. Это те же пять точек, просто в виде картинки вместо строки таблицы."
            player "Графики помогут, только если внутри есть что показывать — колебания, ход по времени."
            player "Значит, дело не в визуализации. Дело в том, что сама цифра — среднее — уже стёрла то, что мне нужно увидеть."
            player "Стандартное отклонение. Вот чего не хватает."
            $ accuracy += 6

            jump task1_std_how

        "Стандартного отклонения — чтобы увидеть, насколько данные разбросаны.":
            $ task1_route = "std_direct"
            window show
            boss "И как это поможет тебе прямо сейчас?"
            player "Оно скажет, насколько сильно данные каждого магазина скачут вокруг среднего. Где сильнее всего — там и спрятанная аномалия, которую среднее просто не показывает."
            $ accuracy += 10

            jump task1_std_how


label task1_std_how:
    boss "Хорошо. Вот данные по дням для всех пяти магазинов — за последние двенадцать дней. Выручки тебе хватит? Можешь рассчитать это своё стандартное отклонение по ней?"

    window hide
    show image "images/task1_std_data_D.png" at Transform(fit="contain", size=(1920, 700)):
        xalign 0.5
        yalign 0.05
    with dissolve

    pause 3.0

    menu:
        "Убери это безумие, оно пугает меня!":
            pass

    window show

    if task1_route == "raw_data":
        boss "Но ты же сам просил!"
        player "Но нельзя же так сразу без прелюдий."
    else:
        boss "Аналитик испугался данных?"

    "«Уходящие в бесконечность таблицы кого угодно сведут с ума», — думаешь ты."
    $ unlock_memory("beskonechnye_tablitsy")
    player "Я не буду считать это в уме. Дайте мне доступ хоть в какой-то рабочий инструмент."
    boss "Доступы не положены, всё секретно. Расскажи мне, как это считается, и я скажу, что получилось."
    "Ты не уверен, что помнишь как считается стандартное отклонение."
    "Ты не обязан помнить всё. Достаточно знать, как это делается верно в хоть одном инструменте."

    window hide
    menu:
        "Математика.":
            $ task1_tool_used = "math"
            jump task1_std_math_how

        "Excel.":
            $ task1_tool_used = "excel"
            jump task1_std_excel_how

        "Python.":
            $ task1_tool_used = "python"
            jump task1_std_python_how


label task1_std_math_how:
    window show
    $ news_list.extend([
        "Журналисты спросили, что помогает сети «Изобилие» расти в два раза быстрее рынка. «Наши аналитики используют лучший инструмент анализа — глубокое понимание математики», — заявили в компании."
    ])
    $ unread_news = True
    boss "Формулой? Какой?"
    window hide
    menu:
        "Разница между максимумом и минимумом.":
            window show
            boss "Так... У D — 57. У остальных — от семнадцати до двадцати восьми. Разница вроде видна?"
            player "Хотя, кстати, я вам соврал: мы посчитали размах, а не отклонение — спутал на автомате."
            boss "Я это запомню. И не для того, чтобы выписать премию. Объяснись."
            player "Размах — это просто «самое большое минус самое маленькое». Быстро, но не совсем то."
            player "Я вспомнил — отклонение считается вот так. Давайте посмотрим на него тоже."
            player "Каждое отклонение от среднего — в квадрат, потом среднее по ним, потом корень."
            boss "Так.."
            player "И?"
            boss "19.5. У остальных — от пяти до девяти. У D — почти втрое больше. Если ты прав, то аномалия в точке D."
            player "Разница объяснимая: размах иногда случайно совпадает с правдой, если аномалия и правда сидит в самых крайних значениях. Но полагаться на это нельзя — он не видит общую картину, только два случайных экстремума."
            $ accuracy += 3

            jump task1_question1_correct

        "Квадратный корень из среднего квадратов отклонений от среднего.":
            window show
            player "Каждое отклонение от среднего — в квадрат, потом среднее по ним, потом корень."
            boss "Так.."
            player "И?"
            boss "У D 19.5. У остальных — от пяти до девяти. У D — почти втрое больше. Если ты прав, то аномалия в точке D."
            $ accuracy += 4

            jump task1_question1_correct

        "Среднее отклонение каждого значения от среднего.":
            window show
            boss "Получилось ноль. Ноль — то есть аномалии вообще нет?"
            player "...Не может быть."
            player "А, точно — плюсы и минусы взаимно уничтожаются, если не убрать знак. Так будет ноль для вообще любых чисел."
            boss "Я это запомню. И не для того, чтобы выписать премию. Объяснись."
            player "Нужен квадрат каждого отклонения — тогда знаки исчезают правильно, не обнуляя всё подчистую."
            player "Каждое отклонение от среднего — в квадрат, потом среднее по ним, потом корень."
            boss "Так.."
            player "И?"
            boss "У D 19.5. У остальных — от пяти до девяти. У D — почти втрое больше. Если ты прав, то аномалия в точке D."
            $ accuracy += 2

            jump task1_question1_correct


label task1_std_excel_how:
    window show
    $ news_list.extend([
        "Сеть «Изобилие» назвала Excel секретным оружием аналитики. Акции разработчика электронных таблиц не отреагировали никак."
    ])
    $ unread_news = True
    boss "В Excel. Какой функцией?"
    window hide
    menu:
        "СТАНДОТКЛОН.В.":
            window show
            boss "Считаю через СТАНДОТКЛОН.В."
            player "И?"
            boss "У D 20.4. У остальных — от пяти до девяти. У D — почти втрое больше. Если ты прав, то аномалия в точке D."
            $ accuracy += 4

            jump task1_question1_correct

        "МАКС минус МИН.":
            window show
            boss "Так... У D — 57. У остальных — от семнадцати до двадцати восьми. Разница вроде видна?"
            player "Хотя, кстати, я вам соврал: мы посчитали размах, а не отклонение — спутал на автомате."
            boss "Я это запомню. И не для того, чтобы выписать премию. Объяснись."
            player "МАКС-МИН — это просто «самое большое минус самое маленькое». Быстро, но не совсем то."
            player "Я вспомнил — отклонение считается через СТАНДОТКЛОН.В. Давайте посмотрим на него тоже."
            boss "Считаю."
            player "И?"
            boss "У D 20.4. У остальных — от пяти до девяти. У D — почти втрое больше. Если ты прав, то аномалия в точке D."
            player "Разница объяснимая: размах иногда случайно совпадает с правдой, если аномалия и правда сидит в самых крайних значениях. Но полагаться на это нельзя — он не видит общую картину, только два случайных экстремума."
            $ accuracy += 3

            jump task1_question1_correct

        "СРЗНАЧ от разностей каждого значения со средним.":
            window show
            boss "Получилось ноль. Ноль — то есть аномалии вообще нет?"
            player "...Не может быть. А, точно — без ABS() плюсы и минусы взаимно уничтожаются. Так выйдет ноль для вообще любых чисел."
            boss "Я это запомню. И не для того, чтобы выписать премию. Объяснись."
            player "Нужна СТАНДОТКЛОН.В — там разности возводятся в квадрат перед усреднением, а не остаются со знаком."
            boss "Считаю."
            player "И?"
            boss "У D 20.4. У остальных — от пяти до девяти. У D — почти втрое больше. Если ты прав, то аномалия в точке D."
            $ accuracy += 2

            jump task1_question1_correct


label task1_std_python_how:
    window show
    $ news_list.extend([
        "В «Изобилии» подтвердили: без строчки кода на Python теперь не открывают ни один магазин. Змея ни при чём, уверяют в пресс-службе."
    ])
    $ unread_news = True
    boss "На Python. Как именно?"
    window hide
    menu:
        "max(data) - min(data).":
            window show
            boss "Так... У D — 57. У остальных — от семнадцати до двадцати восьми. Разница вроде видна?"
            player "Хотя, кстати, я вам соврал: мы посчитали размах, а не отклонение — спутал на автомате."
            boss "Я это запомню. И не для того, чтобы выписать премию. Объяснись."
            player "max(data) - min(data) — это просто «самое большое минус самое маленькое». Быстро, но не совсем то."
            player "Я вспомнил — отклонение считается через numpy.std(). Давайте посмотрим на него тоже."
            boss "Считаю."
            player "И?"
            boss "У D 19.5. У остальных — от пяти до девяти. У D — почти втрое больше. Если ты прав, то аномалия в точке D."
            player "Разница объяснимая: размах иногда случайно совпадает с правдой, если аномалия и правда сидит в самых крайних значениях. Но полагаться на это нельзя — он не видит общую картину, только два случайных экстремума."
            $ accuracy += 3

            jump task1_question1_correct

        "sum(x - mean for x in data) / len(data).":
            window show
            boss "Получилось ноль. Ноль — то есть аномалии вообще нет?"
            player "...Не может быть. А, точно — без abs() или возведения в квадрат плюсы и минусы взаимно уничтожаются. Так выйдет ноль для вообще любых чисел."
            boss "Я это запомню. И не для того, чтобы выписать премию. Объяснись."
            player "numpy.std() — вот что нужно, там квадраты отклонений и корень, а не сырая сумма разностей."
            boss "Считаю."
            player "И?"
            boss "У D 19.5. У остальных — от пяти до девяти. У D — почти втрое больше. Если ты прав, то аномалия в точке D."
            $ accuracy += 2

            jump task1_question1_correct

        "numpy.std(data).":
            window show
            player "Считайте через numpy.std()."
            boss "A... B... C..."
            boss "У D 19.5. У остальных — от пяти до девяти. У D — почти втрое больше. Если ты прав, то аномалия в точке D."
            $ accuracy += 4

            jump task1_question1_correct



label task1_question1_correct:
    window show
    player "Вполне может быть."
    if task1_tool_used == "excel":
        player "Кстати, у Excel вышло 20.4, а не 19.5: он по умолчанию делит на n-1, а не на n. На двенадцати днях разница заметна, на сотне почти пропала бы."
    player "Стандартное отклонение показывает разброс, а не только центр. Если оно большое — где-то внутри резкие скачки, которые среднее аккуратно замело под ковёр."
    player "У D оно выше, чем у остальных. Вот и вся спрятанная аномалия."
    boss "Красиво говоришь. Покажи пальцем, что именно у D не так."

    window hide
    call screen d_column_hunt
    $ d_picked = _return
    $ d_found = [i for i in d_picked if i in (2, 9)]
    $ d_extra = [i for i in d_picked if i not in (2, 9)]
    show screen d_spikes_reveal
    window show

    if len(d_found) == 2 and not d_extra:
        player "Орлиное зрение, неземная внимательность. Вот."
        $ accuracy += 3
    elif len(d_found) == 2:
        player "Кажется, я случайно отметил лишнее... Но и верный ответ нашёл!"
        $ accuracy += 1
    elif len(d_found) == 1:
        player "Вот с этим точно что-то не так, но, кажется, я что-то упустил...."
    elif not d_picked:
       player "Честно? От этих цифр рябит в глазах. Я ничего не вижу."
    else:
        player "Видите, длинные таблицы свели меня с ума. Натыкал что-то невразумительное."

    player "Два раза... по 165 ровно. Вот оно, подозрительное наше."
    hide screen d_spikes_reveal
    hide image "images/task1_std_data_D.png"
    player "В среднем она такая же, как и все остальные, но внутри два дня из двенадцати выручка выстреливает вверх, как пробка из шампанского. В остальное время тише воды."
    boss "Тогда следующий вопрос: проблема в самих данных или в том, как они к нам попадают?"
    player "Любите вы задавать вопросы без хороших вводных..."
    player "Проверили, что каждая запись корректна? Формат, суммы, коррупцию? Исключили фактор прохода кота по клавиатуре?"
    boss "Каждая запись проверена по отдельности. Ошибок нет."
    player "Тогда дело не в записях. Дело где-то вокруг них."
    "Проходит минута, прежде чем тебя озаряет мысль."
    player "Так, то, что я выскажу сейчас, это предположение, а не факт."
    player "Может, дело не в том, что записано, а в том, что происходит до записи. Если сами цифры чисты, а разброс всё равно есть — узкое место где-то в процессе, раньше, чем данные попадают в таблицу."
    player "Смотрите, как это устроено технически: касса принимает оплату локально, а потом отправляет запись на центральный сервер. Вот в этой передаче и может быть проблема."
    boss "Например?"
    $ mech_solved = []
    $ mech_hits = 0
    $ renpy.random.shuffle(mech_layout)
    show screen mech_board_view(mech_solved) with dissolve

    player "Смотрите, как это бывает. Покупатель расплатился в десять утра, а сервер в этот момент не отвечает. Терминал не выбрасывает чек, а откладывает в сторону и пробует снова — через минуты, а иногда через часы. Продажа есть, но в отчёте она появится только вечером."
    call mech_round("delay")
    boss "Хорошо, задержка. Дальше?"

    player "А бывает хуже. Терминал стучится на сервер раз, другой, третий — ответа нет. После нескольких попыток он сдаётся и забывает про этот чек. Покупатель ушёл с покупкой, деньги в кассе лежат, а в отчёте этой продажи просто нет."
    call mech_round("loss")
    boss "А если наоборот?"

    player "Тогда вот что. Терминал отправил чек, а ответ от сервера где-то заблудился. Терминал думает: «не дошло» — и отправляет тот же чек ещё раз. А на самом деле дошло с первого. Если сервер не умеет узнавать повторы, он послушно запишет оба. Покупка одна, а в отчёте две."
    call mech_round("dup")

    player "И ещё один сценарий. Связь пропала на сутки, терминал честно копил чеки. Утром она вернулась — и всё накопленное хлынуло на сервер разом, как вода из прорванной плотины. В отчёте это выглядит как аномальный день, хотя настоящие покупки были размазаны по нескольким."
    call mech_round("burst")

    boss "И ни одну из этих проблем не видно, пока проверяешь записи по одной. Хитро."
    hide screen mech_board_view with dissolve

    player "Именно поэтому ваша проверка ничего и не поймала. Каждая отдельная запись безупречна — правильная сумма, правильный товар. Беда возникает на уровне всего набора: записей не хватает, или их больше, чем было продаж, или они пришли не в тот день. Проверять надо не только каждую запись, но и весь набор целиком — всё ли на месте, нет ли повторов, вовремя ли пришло."
    boss "Начинаю видеть ход мысли. Отклонение растёт из-за дней, когда накопившееся выплёскивается разом, — на фоне обычных дней они торчат, как шпили."
    player "Ровно так."

    boss "Разумно. Но почему тогда именно у точки D? У остальных магазинов те же кассы, та же сеть."
    window hide

    menu:
        "Может, сервер точки D делит канал с чем-то ещё, не связанным напрямую с продажами.":
            player "Если через тот же сервер идёт какая-то другая нагрузка — не имеющая отношения к кассам вообще — обычный розничный трафик начнёт страдать именно там, где эта посторонняя нагрузка выше."
            boss "То есть проблема не в самой точке D, а в том, с чем она делит инфраструктуру?"
            player "Именно. Магазин ни при чём. При чём — что-то ещё на том же канале."
            player "График нагрузки позволил бы сказать точнее."
            $ accuracy += 2
            $ intuition += 1

        "Может, там просто более старое оборудование.":
            player "Например, там сервер физически слабее или давно не обновлялся."
            boss "Слабое железо подводило бы нас в любой день, а не в два из двенадцати. Или нет?"
            player "Не обязательно: старый сервер может держаться, пока нагрузка обычная, и сыпаться, когда она подскакивает. Без графика нагрузки гипотезу не принять и не отбросить."
            player "Хороший повод достать такой график, кстати."

        "Может, там персонал хуже обучен и чаще ошибается.":
            player "Где-то, наверное, кто-то путает кнопки на кассе."
            boss "Перепутанная кнопка меняет одну запись. А у D целые дни выше обычного почти в полтора раза. Кнопками это не объяснить."
            player "Согласен: ошибка в одном чеке не поднимает выручку целого дня. Снимаю гипотезу."
            player "Остаётся то, что вокруг записей: канал, сервер, нагрузка. Хорошо бы взглянуть на график нагрузки."

    boss "Окей, стоит посмотреть на выручку и нагрузку... Хорошо, я достану тебе график и вернусь. Пока выходи на рабочий стол."
    $ news_list.extend([
        "СРОЧНО — Президент Остазии встретился с президентом Океании. 'Дух Лондона' снова витает в воздухе?",
        "Житель Боброкурвска заявил о крушении НЛО. Власти округа призывают не паниковать — это всего лишь баллистическая ракета.",
        "Отрицательный рост на нью-йоркской бирже продолжается пятую неделю подряд."
    ])
    $ unread_news = True

    $ current_task = 2
    $ sasha_phase = 1


    $ game_minutes_total += renpy.random.randint(20, 115)
    jump desktop_loop
