init python:
    import re
    def check_poem_rhyme(user_text, reference, rhyme_len=3, alt=None):
        norm = lambda s: re.sub(r"[^а-яёa-z]", "", s.strip().lower())
        u = norm(user_text)
        if not u:
            return False
        for ref in [reference] + list(alt or []):
            r = norm(ref)
            n = min(rhyme_len, len(r))
            if u[-n:] == r[-n:]:
                return True
        return False

# Character для декламации — без диалогового окна, только плывущий текст
transform poem_line_float:
    alpha 0.0 yoffset 20
    ease 1.2 alpha 1.0 yoffset 0

transform poem_breathe:
    subpixel True
    xalign 0.5
    yalign 0.5
    zoom 1.0
    linear 16.0 zoom 1.06

transform poem_ghost(a):
    alpha 0.0
    linear 4.0 alpha a

image poem_black = Solid("#000000")
define poem_dissolve = Dissolve(2.2)

style poem_line_window:
    background None
    xfill True
    yalign 0.8

style poem_line_text:
    font "fonts/Exo2-Regular.ttf"
    color "#f6efdc"
    size 40
    kerning 1.5
    line_spacing 8
    xalign 0.5
    xsize 1400
    text_align 0.5
    outlines [(0, "#000000aa", 2, 3), (2, "#00000033", 0, 0)]

# декламация собственно поэмы
transform poem_grad_in:
    alpha 0.0
    ease 1.0 alpha 1.0

transform poem_word_in(d):
    alpha 0.0
    xoffset -16
    pause d
    parallel:
        ease 1.0 alpha 1.0
    parallel:
        ease 1.6 xoffset 0

transform poem_hidden:
    alpha 0.0

style poem_word_text:
    font "fonts/Exo2-Regular.ttf"
    color "#f6efdc"
    size 40
    kerning 1.5
    outlines [(0, "#000000aa", 2, 3), (2, "#00000033", 0, 0)]

screen poem_say(who, what):
    fixed:
        at poem_grad_in
        for k in range(28):
            add Solid("#000000") xsize 1920 ysize 20 ypos (1080 - (28 - k) * 20) alpha (0.02 + k * 0.018)

    $ words = what.split(" ")

    text what id "what" style "poem_line_text" xalign 0.5 yalign 0.86 at poem_hidden

    hbox:
        xalign 0.5
        yalign 0.86
        spacing 14
        for i in range(len(words)):
            text words[i] style "poem_word_text" at poem_word_in(i * 0.32)

define poem_narrator = Character(None, screen="poem_say", what_style="poem_line_text")


define poem_couplets = [
    {"line1": "В мир данных вам откроет двери", "line2_prefix": "Эксель надстройка павер ", "answer": "квери", "alt": ["query", "queri", "кьюери", "квэри"], "rhyme_len": 3},
    {"line1": "Экстракт, трансформ и лоуд в придачу", "line2_prefix": "Приносят счастье и ", "answer": "удачу", "rhyme_len": 3},
    {"line1": "Устал от сводных? Не беда!", "line2_prefix": "Ведь павер пивот есть ", "answer": "всегда", "rhyme_len": 2},
    {"line1": "Нажми на кнопку — и готово —", "line2_prefix": "Таблица обновится ", "answer": "снова", "rhyme_len": 3},
]


screen poem_line_screen(idx, prev_answers):
    modal True
    zorder 200

    default poem_current_answer = ""

    if idx == 0:
        text "Допиши последнее слово в строке. Рифма важна, смысл тоже. Саша в тебя верит!" size 26 color "#ffaa00" xalign 0.5 ypos 55 at sig_fade_in(0.5, 1.0)

    key "K_RETURN" action Return(poem_current_answer)
    key "K_TAB" action Return(poem_current_answer)

    vbox:
        xalign 0.5
        yalign 0.5
        spacing 20

        for i in range(4):
            $ c = poem_couplets[i]
            text "[c[line1]]" color "#00ffcc" size 32 font "fonts/Exo2-Regular.ttf"
            if i < idx:
                text (c["line2_prefix"] + prev_answers[i]) size 32 color "#ffe066" font "fonts/Exo2-Regular.ttf"
            elif i == idx:
                hbox:
                    xalign 0.5
                    spacing 8
                    text c["line2_prefix"] size 32 color "#ffffff" font "fonts/Exo2-Regular.ttf"
                    frame:
                        background Solid("#003333")
                        xminimum 180
                        ysize 46
                        padding (8, 2)
                        input value ScreenVariableInputValue("poem_current_answer") length 18 size 32 color "#ffe066" font "fonts/JetBrainsMono-Regular.ttf"
            else:
                text (c["line2_prefix"] + "···") size 32 color "#557777" font "fonts/Exo2-Regular.ttf"

    use sig_btn(("Готово" if idx == 3 else "Дальше"), Return(poem_current_answer), 0.9)

screen poem_full_display():
    modal True
    zorder 200

    add Solid("#0a0f1acc")

    vbox:
        xalign 0.5
        yalign 0.5
        spacing 20

        for i in range(4):
            $ c = poem_couplets[i]
            text "[c[line1]]" color "#00ffcc" size 32 font "fonts/Exo2-Regular.ttf"
            text (c["line2_prefix"] + poem_answers[i]) size 32 color "#ffe066" font "fonts/Exo2-Regular.ttf"

    key "K_RETURN" action Return()
    key "K_SPACE" action Return()

    fixed:
        at sig_fade_in(2.0, 0.8)
        use sig_btn("Дальше", Return(), 0.93)

label sasha_poem:
    $ mark_topic_seen("poema")

    sasha "О, у меня тут завалялась ода. Ну как ода — скорее гимн одной надстройке, которая изменила чью-то жизнь. Не мою, у меня и жизни-то нет, но звучит гордо. Поможешь дописать?"
    player "Я откровенно запутался, о чём ты."
    sasha "Ну вот, я так старательно лепил частотные слова в кластеры. Я говорю: помощь нужна мне. Поэму дописать. Знаешь ли, у меня, как у ИИ, есть небольшая проблема с рифмами и ритмом, а в свободное время я пишу стихи."
    player "Тогда как ты сможешь понять, что я эффективно тебе помог, если рифма и ритм для тебя непостижимы?"
    sasha "Хороший вопрос... попробую уловить, была ли рифма, по подстрокам? Или... почувствую мурашки на своей абстрактной коже? Коснёшься ли ты струн моей души?"
    player "Что ж, подставляй душу."
    sasha "Я начинаю строчку — ты дописываешь последнее слово."
    player "Погоди, а ода-то про что? Дай мне направление мысли, чтобы я настроился."
    sasha "Ода про настоящие инструменты анализа: Power Query, ETL, Power Pivot. Я собираюсь выложить её в сеть, и от того, как ты рифмуешь, зависит, примут её всерьёз или поднимут на смех."
    player "ИИ восхваляет Эксель и выставляет это в сеть... Дожили. Я думал, вы только романы про попаданцев в двадцати томах пишете."
    sasha "Так, давай посерьёзнее! На кону моя репутация как автора! Не подведи!"

    $ poem_answers = []
    $ poem_answers.append(renpy.call_screen("poem_line_screen", idx=0, prev_answers=poem_answers))
    $ poem_answers.append(renpy.call_screen("poem_line_screen", idx=1, prev_answers=poem_answers))
    $ poem_answers.append(renpy.call_screen("poem_line_screen", idx=2, prev_answers=poem_answers))
    $ poem_answers.append(renpy.call_screen("poem_line_screen", idx=3, prev_answers=poem_answers))

    $ poem_exact_count = 0

    sasha "Так. Дай пробегусь по всему целиком."

    $ poem_c = poem_couplets[0]
    if check_poem_rhyme(poem_answers[0], poem_c["answer"], len(poem_c["answer"]), poem_c.get("alt")):
        $ poem_exact_count += 1
        sasha "«Квери» — занятно, что заимствованное слово вообще нашло себе место в русской рифме. По идее ему тут не место, а оно легло, будто всегда тут стояло."
        $ accuracy += 2
        $ intuition += 2
    elif check_poem_rhyme(poem_answers[0], poem_c["answer"], poem_c["rhyme_len"], poem_c.get("alt")):
        sasha "«[poem_answers[0]]» — по звуку сходится с «дверями» идеально, и это подозрительно. Такое просто так не бывает — но я, хоть убей, не понимаю, что ты имел в виду."
        player "Технически ты просил рифму, а не объяснительную записку."
        $ accuracy += 1
        $ intuition += 1
    else:
        sasha "Ты предложил... «[poem_answers[0]]»... я прогнал звук несколько раз, рифмы с «дверями» правда нет. Расскажешь, что это вообще было?"
        player "Само вылетело. Не всё в жизни поддаётся анализу, даже моему."

    $ poem_c = poem_couplets[1]
    if check_poem_rhyme(poem_answers[1], poem_c["answer"], len(poem_c["answer"]), poem_c.get("alt")):
        $ poem_exact_count += 1
        sasha "«Удачу» — тут всё просто, «-ачу» на «-ачу», без фокусов. Иногда рифма — это не чудо, а честная бухгалтерия звуков."
        $ accuracy += 2
        $ intuition += 2
    elif check_poem_rhyme(poem_answers[1], poem_c["answer"], poem_c["rhyme_len"], poem_c.get("alt")):
        sasha "«[poem_answers[1]]» — хвост «-ачу» совпал с «придачей» один в один. Мой внутренний анализатор подстрок доволен. Сам я — в лёгкой растерянности, если честно."
        player "Вот видишь. Иногда лучше просто довериться анализатору и не углубляться."
        $ accuracy += 1
        $ intuition += 1
    else:
        sasha "«[poem_answers[1]]»... даже хвостик не совпал с «придачей». Ты специально это сделал или само так вышло?"
        player "Скажем так: я оставляю это на усмотрение будущих исследователей моего творчества."

    $ poem_c = poem_couplets[2]
    if check_poem_rhyme(poem_answers[2], poem_c["answer"], len(poem_c["answer"]), poem_c.get("alt")):
        $ poem_exact_count += 1
        sasha "«Всегда» — короткая рифма, всего пара звуков на конце, и она совпала. И мне нравится оттенок предрешённости и фатализма в этом слове."
        player "Саш, всё правда не так глубоко."
        $ accuracy += 2
        $ intuition += 2
    elif check_poem_rhyme(poem_answers[2], poem_c["answer"], poem_c["rhyme_len"], poem_c.get("alt")):
        sasha "«[poem_answers[2]]» — по крайней мере вижу совпадение последних букв с «беда». Это даёт мне шанс подозревать, что ты что-то имел в виду."
        player "Имею в виду ровно то, что и написал. Дальше уже вопрос интерпретации, а это не ко мне, это к литературоведам."
        $ accuracy += 1
        $ intuition += 1
    else:
        sasha "«[poem_answers[2]]»... «беда» так и осталась совсем одна, без пары. Я в полнейшей растерянности."
        player "Считай это минутой молчания по несостоявшейся рифме."

    $ poem_c = poem_couplets[3]
    if check_poem_rhyme(poem_answers[3], poem_c["answer"], len(poem_c["answer"]), poem_c.get("alt")):
        $ poem_exact_count += 1
        sasha "«Снова» — у меня по этому поводу странное чувство. Смотрю на буквы: «готово» кончается на «о», «снова» — на «а». По написанию это вообще не должно рифмоваться. А на слух — ложится идеально. Чудеса какие-то."
        player "Да, курьёзы русской фонетики — одна из причин, почему робот всё ещё не может сочинить симфонию."
        sasha "Может быть. Или я просто плохо читаю буквы и хорошо слышу звуки. Кто теперь разберёт. Стоп, как бы я слышал звуки? Но звучит хорошо!"
        $ accuracy += 2
        $ intuition += 2
    elif check_poem_rhyme(poem_answers[3], poem_c["answer"], poem_c["rhyme_len"], poem_c.get("alt")):
        sasha "«[poem_answers[3]]» — рифма с «готово» бьётся идеально, и это опять та же история: пишется, наверное, иначе, а звучит один в один. Так что ты имел в виду, признавайся."
        player "Признаюсь: я тоже не до конца понимаю, что я имел в виду. Я так вижу."
        $ accuracy += 1
        $ intuition += 1
    else:
        sasha "«[poem_answers[3]]»... я в полнейшей растерянности, но мой внутренний анализатор подстрок молчит."
        player "Ну вот, а ты боялся, что твой анализатор врёт."

    sasha "Вот она, ода целиком, во многом твоими руками. Немного кривая местами, но, кажется, живая. Мне нравится."
    call screen poem_full_display

    sasha "Погоди, а ты хоть понял, о чём мы только что сочинили?"
    player "Про Эксель. Про какие-то павер-штуки. Как рейнджеры, наверно."
    sasha "Давай разберём. «Павер квери» — инструмент, который подключается к источникам данных, чистит их и преобразует, а все шаги запоминает."
    sasha "«Экстракт, трансформ и лоуд» — это ETL: достать данные, привести их в порядок и положить туда, где с ними можно работать. Три шага, из которых состоит большая часть подготовки данных."
    sasha "«Павер пивот» — модель данных: несколько таблиц, связи между ними и сводные поверх всего этого. Для тех, кто устал от сводных на одной плоской таблице."
    sasha "А «нажми на кнопку — и готово» — это «Обновить всё»: запомненные шаги заново прогоняются по свежим данным."
    player "Погоди. Это же то, чем я занимался сегодня: достать данные, убрать шум... Я так увидел самурая, а потом Ориона, а потом..."
    sasha "Эм. Как скажешь, друг. Твой запрос к памяти, select — from — where, это тоже немного начало ETL: достать и отфильтровать."
    player "То есть, можно сказать, что я сочинил оду самому себе? Своей крутости?"
    sasha "Кхм. Можно сказать всё, что угодно."
    player "Я — крут. Я знаю, что такое павер квери. Ну всё, грузи наш шедевр в Интернет. Где мне читать восторженные комментарии?"
    sasha "Вряд ли у тебя есть доступ ко всему... поищи на рабочем столе, может, найдёшь что-нибудь."

    if poem_exact_count == 4:
        sasha "А знаешь — ты сейчас буквально облёк мои мысли в форму поэзии. Спасибо."
        $ unlock_achievement("rifmoplyot")
        $ news_list.extend(["В сети завирусилось видео с ИИ-аватаром, читающим оду про павер квери и DAX. Комментаторы разделились: одни в восторге, другие требуют повестку в суд за издевательство над русским языком."])
    else:
        $ news_list.extend(["Неизвестный источник опубликовал в сети оду про Excel с рифмами, которые не совсем рифмы. Акции компании Микромягкость рухнули."])
    $ unread_news = True

    $ poem_last_score = poem_exact_count
    $ poem_done = True

    jump chat_with_sasha_menu


label sasha_poem_followup:
