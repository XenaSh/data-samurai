init python:
    def task3_rank_pick(stage):
        if stage in task3_available_stages:
            task3_available_stages.remove(stage)
            rank_order.append(stage)
            renpy.restart_interaction()

    def task3_rank_undo():
        if rank_order:
            last = rank_order.pop()
            task3_available_stages.append(last)
            renpy.restart_interaction()
init python:
    BOXPLOT_FILE = "images/boxplot_revenue.png"
    BOXPLOT_FIT  = (1920, 700)   # то же, что в Transform(fit="contain", size=...)
    BOXPLOT_YALIGN = 0.05        # то же, что yalign у show

    # (x, y, ширина, высота) в долях картинки, для столбца D.
    # Сняты с твоего скриншота на глаз, точность 1-2%.
    BOXPLOT_PARTS = {
        "box":      [(0.640, 0.733, 0.144, 0.084)],
        "levels":   [(0.082, 0.731, 0.558, 0.004), (0.082, 0.815, 0.558, 0.004)],  # от оси Y к краям коробки
        "median":   [(0.640, 0.775, 0.144, 0.020)],
        "whiskers": [(0.676, 0.656, 0.072, 0.077), (0.676, 0.817, 0.072, 0.047)],
        "outliers": [(0.690, 0.090, 0.044, 0.315)],
        "fence":    [(0.620, 0.602, 0.184, 0.004)],  # Q3 + 1,5*IQR, см. ниже
    }

    def boxplot_hl_rects(parts):
        if isinstance(parts, str):
            parts = (parts,)
        iw, ih = renpy.image_size(BOXPLOT_FILE)
        k = min(BOXPLOT_FIT[0] / float(iw), BOXPLOT_FIT[1] / float(ih))
        w, h = int(iw * k), int(ih * k)
        fx = int((config.screen_width - w) * 0.5)
        fy = int((config.screen_height - h) * BOXPLOT_YALIGN)
        out = []
        for p in parts:
            for (x, y, rw, rh) in BOXPLOT_PARTS[p]:
                out.append((fx + int(x * w), fy + int(y * h),
                            max(2, int(rw * w)), max(2, int(rh * h))))
        return out

transform hl_pulse:
    alpha 0.6
    linear 0.7 alpha 1.0
    linear 0.7 alpha 0.6
    repeat

screen boxplot_hl(parts):
    for (x, y, w, h) in boxplot_hl_rects(parts):
        fixed:
            at hl_pulse
            add Solid("#ffaa0040") pos (x, y) xysize (w, h)
            add Solid("#ffaa00") pos (x, y) xysize (w, 2)
            add Solid("#ffaa00") pos (x, y + h - 2) xysize (w, 2)
            add Solid("#ffaa00") pos (x, y) xysize (2, h)
            add Solid("#ffaa00") pos (x + w - 2, y) xysize (2, h)
screen task3_rank_screen():
    frame:
        xalign 0.5
        yalign 0.5
        xsize 900
        ysize 500
        background Solid("#0a0f1acc")
        padding (25, 25)

        vbox:
            spacing 15
            text "Расставь этапы анализа в правильном порядке:" color "#00ffcc" size 26

            hbox:
                spacing 40

                vbox:
                    spacing 8
                    text "Доступные этапы:" color "#888888" size 18
                    for stage in task3_available_stages:
                        textbutton stage action Function(task3_rank_pick, stage) text_size 20 text_color "#e0e0e0"

                vbox:
                    spacing 8
                    text "Твой порядок:" color "#888888" size 18
                    for i, stage in enumerate(rank_order, 1):
                        text "[i]. [stage]" color "#88ff88" size 20

            if rank_order:
                textbutton "Отменить последний выбор" action Function(task3_rank_undo) text_size 18 text_color "#ff8888"

            if len(rank_order) == 4:
                textbutton "Готово" action Return(True) text_size 24 text_color "#00ffcc" xalign 0.5


transform p2_square(delay):
    alpha 0.15
    pause delay
    easein 0.25 alpha 1.0

transform p2_line_grow:
    xzoom 0.0
    pause 1.6
    easein 1.1 xzoom 1.0

transform p2_fade_in(delay=0.0, dur=0.9):
    alpha 0.0
    pause delay
    easein dur alpha 1.0

transform p2_glitch_in(delay=0.0):
    alpha 0.0
    pause delay
    alpha 1.0
    pause 0.06
    alpha 0.15
    pause 0.06
    alpha 1.0
    pause 0.04
    alpha 0.5
    pause 0.04
    alpha 1.0

screen phase2_complete_screen():
    fixed:
        hbox:
            xalign 0.5
            ypos 395
            spacing 26
            for i in range(3):
                add Solid("#00ffcc") xysize (16, 16) at p2_square(0.3 + i * 0.4)

        text "ФАЗА 2" size 34 color "#00ffcc" kerning 14 xalign 0.5 ypos 440 at p2_fade_in(1.4)
        add Solid("#00ffcc") xysize (1100, 2) xalign 0.5 ypos 500 at p2_line_grow
        text "ЗАВЕРШЕНА" size 96 font gui.name_text_font color "#ffffff" kerning 6 xalign 0.5 ypos 530 at p2_glitch_in(2.7)
        text "Задания выполнены. Дальше — только он и ты." size 24 color "#9fe8d8" xalign 0.5 ypos 660 at p2_fade_in(4.2, 1.2)


label task3:
    if task3_awaiting_access:
        $ task3_awaiting_access = False
        jump task3_conclusion_2

    window show
    hide screen desktop
    hide screen investigation_bar
    scene bg_task1_briefing
    with dissolve

    boss "Кажется, я разгадал, как ты мыслишь. Посмотри на график — тебе будет интересно."
    player "Вот так сразу? Мы даже не актуализируем, на чём закончили в прошлый раз?"
    boss "Это не слишкмо важно. Просто отвечай."
    $ unlock_memory("tochny_otvet")

    show image "images/boxplot_revenue.png" at Transform(fit="contain", size=(1920, 700)):
        xalign 0.5
        yalign 0.05
    with dissolve

    boss "..."
    "Ты ждёшь хоть какой-нибудь вопрос."
    boss "Реагируй."
    player "Так. Ну. У D что-то не так с формой. Как и ожидалось — это же и есть наш аномальный товарищ. Остальные — компактные коробочки. А этот будто пытается выбраться за рамку."
    boss "В чём вообще смысл этого странного вида графика? И почему у «коробок» растут «усы»?"
    player "Смысл — показать не одно число, а сразу всю компанию значений: где большинство толпится, а где отдельные чудики свалили за пределы вечеринки."
    boss "Ты отвечаешь не как аналитик, а как... человек какой-то. Ещё раз: что это значит? Что за коробочки?"
    player "Хорошо. Точнее. Коробка — межквартильный интервал: от двадцать пятого до семьдесят пятого процентиля."
    show screen boxplot_hl(("box", "levels"))
    player "То есть это интервал, в котором лежит середина данных: ровно половина всех значений. Посмотрите на ось ординат — там тысячи рублей. Выходит, что у D половина значений выручки укладывается где-то между 80 и 110 тысячами."

    show screen boxplot_hl("median")
    player "Линия внутри — медиана. Это такое значение, которое делит все данные как бы пополам: половина значений выше неё, половина — ниже."

    show screen boxplot_hl(("whiskers", "fence"))
    player "«Усы» — это ещё не выбросы. Они тянутся до самого дальнего значения, которое не уходит от коробки дальше, чем на полторы её высоты. Вот эта черта — граница."

    show screen boxplot_hl("outliers")
    player "А дальше — отдельные точки. Статистика называет их выбросами. Это тоже значения выручки, настоящие, они у нас есть... но они необычные. Они за пределами того, что для этого магазина типично."

    hide screen boxplot_hl
    player "Таким образом, глядя на график, мы сразу видим, какие значения у нас типичные, а какие — нет. Понимаете?"
    boss "Допустим. Квартиль, процентиль..."
    player "Могу разложить по формуле, если нужно."

    jump task3_q1


label task3_q1:
    window show
    boss "Как ты интерпретируешь этот график?"
    window hide

    menu:
        "У D шире весь разброс значений — от минимума до максимума.":
            window show
            boss "А межквартильный интервал — то есть основная масса значений без крайностей — он тоже шире?"
            player "...Нет. Коробка у D примерно того же размера, что у остальных. Разброс основной массы не изменился."
            player "Значит, дело не в общем разбросе. Дело в отдельных точках за пределами усов."
            $ accuracy += 2
            window hide
            jump task3_step2

        "У D просто больше точек данных на графике.":
            window show
            boss "Больше точек — откуда, если период наблюдения один и тот же для всех магазинов?"
            player "...Ниоткуда. Данных ровно столько же,да. Просто у D часть точек оказалась дальше от общей массы — вот что бросается в глаза, не количество."
            $ accuracy += 2
            window hide
            jump task3_step2

        "У D сопоставимый разброс в целом, но заметно больше отдельных выбросов за пределами усов.":
            window show
            player "Межквартильный интервал у D — как у всех. Но выбросов, точек за пределами усов, — на порядок больше нормы."
            $ accuracy += 10
            window hide
            jump task3_step2


label task3_step2:
    window show
    hide image "images/boxplot_revenue.png" with dissolve
    boss "Ещё один график. Что скажешь на этот раз?"

    hide image "images/boxplot_revenue.png"
    show image "images/scatter_correlation.png" at Transform(fit="contain", size=(1920, 700)):
        xalign 0.5
        yalign 0.05
    with dissolve

    player "Ну, тут хотя бы обошлось без коробочек. Просто облако. Два облака. Чем выше выручка D, тем выше нагрузка на сервер."
    boss "Выражаясь твоим языком, рой мух тут и рой мух там поменьше."
    "Тебе одновременно приятно и неприятно, что начальник запомнил твою личную манеру общения."
    player "Справедливо. Но я бы сказал, что это всё-таки довольно дисциплинированный рой."
    player "Если бы связи не было, точки были бы разбросаны как попало. А тут явно вытянутая форма: растёт одно — растёт и другое."
    boss "Корреляция, о которой ты говоришь, скрывается за буквой r на графике?"
    player "Да. Число от минус одного до одного. Чем ближе к единице, тем плотнее рой держит строй."
    $ unlock_memory("dve_osi")
    player "И вот прямо на графике — r равно 0,76. Не нужно щуриться и прикидывать на глаз, число уже посчитано за меня."
    player "Достаточно близко к единице, чтобы не списывать это на случайность."
    boss "А как называется такой тип диаграммы? Выглядит полезной."
    player "Конечно, она очень полезна, помогает видеть корреляцию. Это..."

    window hide
    menu:
        "...линейный график. Точки соединены, видно, как всё растёт.":
            window show
            boss "Но линий тут нет. Одни точки."
            player "...Нет. И правда. Что я вообще сказал?"
            player "Это диаграмма рассеяния."
            $ accuracy += 2
            window hide

        "...диаграмма рассеяния. В Excel её называют «точечной».":
            window show
            boss "Рассеяния... Кто кого куда рассеял?"
            player "Каждая точка — один день: по одной оси выручка, по другой — нагрузка. Всё, что «разлетелось» по диагонали, и есть связь."
            $ accuracy += 6
            window hide

        "...та же, что и прошлая. Ящик с усами.":
            window show
            boss "Усы я помню. Но тут нет ни одной коробки."
            player "...Нет. Ящик с усами показывает, как распределены значения одного показателя. А тут их два — выручка и нагрузка, и по точке на каждый день."
            player "Это диаграмма рассеяния. Другой инструмент, другой вопрос."
            $ accuracy += 2
            window hide

        "...не помню название. Зато вижу, что она делает: каждая точка — это один день, по одной оси выручка, по другой нагрузка.":
            window show
            boss "Движешься на интуиции? Формальные названия — тоже часть профессии."
            player "Справедливо. Диаграмма рассеяния. Всё я помню. но не сразу. Суть я понял раньше названия. Обычно так и бывает."
            $ accuracy += 4
            $ intuition += 4
            window hide

    jump task3_q2

    jump task3_q2


label task3_q2:
    window show
    boss "Как ты интерпретируешь эту связь?"
    window hide
    menu:
        "Нагрузка на сервер поднимает выручку.":
            window show
            player "Проверим на вопросе: если завтра мы специально загрузим сервер, выручка вырастет?"
            boss "Это можно устроить."
            player "Не нужно. Дайте мне подумать."
            player "Ответ и так ясен: нет. Сервер продаёт ровно столько, сколько продают люди. Значит, стрелка в эту сторону не работает."
            $ accuracy += 2
            window hide

        "Выручка поднимает нагрузку: больше покупателей, больше запросов.":
            window show
            player "Но это механизм, который я придумал, а не увидел на графике."
            boss "Хм."
            $ accuracy += 2
            window hide

        "Связь сильная, а что из чего следует, пока неясно.":
            window show
            player "Корреляция говорит, что величины растут вместе. Почему, она не говорит."
            player "Это самый честный ответ. Но он совсем не говорит, что делать дальше."
            $ accuracy += 6
            window hide

        "Возможно, их обеих двигает что-то третье: оба показателя растут из-за одной причины.":
            window show
            player "Допустим, что и выручка, и нагрузка зависят от чего-то общего. От чего-то, что случается в одни и те же дни."
            player "...Среда. Пики по средам, и нагрузка по средам."
            boss "И? На что ты намекаешь?"
            player "А вы любите глядеть на небо, начальник?"
            boss "Нет."
            player "..."
            $ accuracy += 10
            $ task3_third_factor = True
            window hide

    jump task3_step4


label task3_step4:
    hide image "images/scatter_correlation.png" with dissolve
    window show
    boss "Ты знаешь так много графиков и можешь по ним находить такие интересные закономерности... В чём твой секрет? Какая у вас, аналитиков, методология?"
    window hide

    $ task3_available_stages = [ "Расчёт статистических показателей", "Сбор и очистка данных", "Визуализация данных", "Интерпретация результатов"]
    $ rank_order = []

    call screen task3_rank_screen

    $ correct_order = ["Сбор и очистка данных", "Расчёт статистических показателей", "Визуализация данных", "Интерпретация результатов"]
    $ rank_score = sum(2 for i in range(4) if rank_order[i] == correct_order[i])

    window show
    if rank_score == 8:
        player "Порядок сам сложился в голове — будто я делал это тысячу раз. Сбор, расчёт, визуализация, вывод."
    else:
        player "Порядок не совсем тот, но общая логика где-то рядом."
        $ news_list.extend([
            "Сеть «Изобилие» объявила о полном пересмотре методологии аналитики с нуля. Итог: три отдела теперь измеряют одну и ту же выручку тремя разными способами и получают три разных числа."
        ])
        $ unread_news = True

    boss "Теперь я чувствую, что мы вплотную подошли к разгадке... Что бы ты предложил делать с магазином D?"

    jump task3_rank_done


label task3_rank_done:
    window show
    player "Прежде чем рекомендовать что-либо, я хочу понять, что D вообще такое. Не «аномальный магазин». А буквально — что там происходит физически, в конкретные среды, в конкретные часы."
    boss "Да какая разница? Ретрансляторы хоть бы сигналы в космос передавали. Разве аналитику важно, что анализировать?"
    player "Ретрансляторы. Сигналы. В космос. Знаете, для человека, увлечённого розничной торговлей, у вас удивительно специфичный словарный запас."
    player "Да, аналитику важно, что анализировать. Мне важно. Может, я не всякий аналитик."
    boss "Как бы поступили твои земные коллеги?"
    "«Твои земные коллеги»."
    player "Мои коллеги сказали бы: вы сами против расследования. Странно ведь — ваш магзин, а вы не хотите разбираться. Только если ваше расследование на самом деле не про точку Д. А про..."
    "Озарение внезапной вспышкой раздаётся в твоём разуме."
    player "Вы боитесь, что я пойму, что это не магазин вообще."
    boss "Как дерзко с твоей стороны решать, кто чего боится."
    player "Дерзко. Возможно. Но вы не сказали, что я ошибаюсь. Вы сказали, что дерзко было это произнести вслух."
    player "Ладно. Не буду больше решать, кто чего боится. Мне нужно то же, что обычно: время и доступ к тому, что происходит внутри D на самом деле. Выводы сделаю не из ваших недомолвок, а из данных."

    window hide
    menu:
        "Это стандартная процедура при любой аномалии такого масштаба. Мне нужен доступ.":
            $ accuracy += 8
            window show
            boss "Процедура. Да, разумеется. Оформи запрос — рассмотрим в порядке очереди."
            "Ты уже слышал этот корпоративный тон раньше. Доступ следует ждать когда-то никогда."
            window hide
            jump task3_access_pending

        "Меня не интересует магазин D сам по себе. Меня интересует, почему его нагрузка коррелирует с сервером именно так.":
            $ accuracy += 6
            $ intuition += 8
            window show
            boss "Корреляция с сервером — это техническая деталь, не имеющая отношения к твоей задаче."
            "Ты чувствуешь, как внутри закипает ярость."
            window hide
            jump task3_access_pending

        "Если это магазин, покажите мне его физически — адрес, персонал, поставщиков. Если не можете — значит, это не магазин.":
            $ accuracy += 2
            $ intuition += 12
            window show
            boss "Ты делаешь выводы, для которых у тебя недостаточно данных."
            window hide
            jump task3_access_pending


label task3_access_pending:
    window show
    boss "Доступы, доступы... вечно клянчишь доступы... Свяжемся позже."
    $ task3_awaiting_access = True
    window hide
    jump desktop_loop


label task3_conclusion_2:
    window show
    scene bg_task1_briefing
    boss "Не благодаря твоей самонадеянности с доступом — но раз уж заговорил..."
    boss "При проверке выяснилось кое-что странное: магазин D не подаёт ни одной заявки на поставку товара. При этом продажи есть."
    player "Продажи без поставок. Товар продаётся, но никто его туда не завозит."
    player "Это либо гениальная схема воровства со склада, либо... честно, я даже не знаю, какое «либо» тут подставить."
    boss "Меня в первую очередь волнует, насколько быстро это способны заметить твои коллеги."
    player "Вас не интересует, что это значит. Вас интересует, кто может это заметить. Это два разных вопроса, и вы только что задали второй, не первый."
    player "Мои коллеги — которых, напомню, у меня формально нет — заметили бы это в течение дня, если бы искали именно это. Не искали бы специально — могли пропустить месяцами."
    boss "Тебе никто не выдавал корпоративный пропуск в виде карт-бланша на неуместные рассуждения."
    boss "Хорошо. Спрошу иначе: сколько у нас времени, прежде чем это заметят те, для кого это действительно важно?"
    "Рабочий день длится уже так долго, а ты всё ещё будто не понимаешь суть."
    "Ты близок к тому, чтобы сдаться. Ты отставляешь расследование на потом и вспоминаешь типовые офисные фразы."

    window hide
    menu:
        "Скорее всего, ошибка в учёте. Предлагаю просто запросить бухгалтерию.":
            $ accuracy += 2
            window show
            boss "Логичное предположение. Бухгалтерия подтвердит рано или поздно."
            window hide
            jump task3_conclusion_3

        "Рассинхронизация продаж и поставок — это либо кража, либо магазин физически не существует так, как заявлено.":
            $ accuracy += 10
            $ intuition += 10
            window show
            boss "Преждевременный вывод. У тебя нет оснований для такого заявления."
            "Начальник отвечает быстрее, чем на предыдущий вопрос."
            window hide
            jump task3_conclusion_3

        "Раз поставок нет — покажите мне хотя бы один накладной документ. Один.":
            $ intuition += 6
            window show
            boss "Документы будут предоставлены в установленном порядке."
            window hide
            jump task3_conclusion_3


label task3_conclusion_3:
    window show
    boss "Сосредоточься на цифрах, а не на догадках. Решай поставленную задачу. Не выдумывай свою собственную."
    "Что он вообще хочет от тебя?"
    player "Забавно. Когда я спрашивал про день недели — это была моя задача. Когда спрашивал про корреляцию — тоже моя задача. А как только вопрос касается того, что магазин D может не существовать физически — внезапно это выдуманная задача."
    player "Граница моей задачи очень удобно сдвигается ровно там, где начинается неудобный ответ."
    boss "Что ж, мой любопытный аналитик. Считай, что ты работаешь в кибербезопасности. Ты проверяешь, насколько быстро злые враги сумеют нас взломать."
    player "Кибербезопасность. Хах."
    player "Хорошо, подыграю. Как специалист по кибербезопасности, я должен сказать: злые враги уже внутри. Данные показывают не внешнее вторжение — они показывают, что нечто выдаёт себя за часть вашей же системы. Магазин D — это не точка входа для взлома. Это уже сам факт, что что-то постороннее давно встроено в инфраструктуру и генерирует поддельные продажи."
    player "Так что нет, я не проверяю, насколько быстро враги нас взломают. Похоже, я проверяю, насколько долго вы делали вид, что не замечаете, что взлом уже произошёл."
    boss "...."
    boss "Что ж. Дорогой сотрудник месяца, выдадим тебе путёвку на море."
    "Ты невольно смеёшься от абсурда происходящего."
    player "Я не хочу путёвку. Я хочу, чтобы вы ответили хотя бы на один вопрос прямо."

    window hide
    menu:
        "Отвечайте прямо. Сейчас. Или я подниму вопрос выше вас.":
            $ intuition += 15
            $ task3_outcome = "escalated"
            window show
            boss "Хватит."
            "Начальник обрывает фразу на середине."
            window hide
            jump task3_reflection

        "Ладно. Оставлю вопрос — не потому, что поверил, а потому что рычагов сейчас нет.":
            $ intuition += 8
            $ accuracy += 4
            $ task3_outcome = "retreated"
            window show
            boss "Мудро. Иногда лучше не знать."
            "Он произносит это тише, чем обычно."
            window hide
            jump task3_reflection

        "Опишу это в отчёте как открытый вопрос — пусть решение примет кто-то выше меня.":
            $ accuracy += 6
            $ task3_outcome = "reported"
            window show
            boss "Выше тебя? Это... любопытно."
            window hide
            jump task3_reflection


label task3_reflection:
    window show
    $ unlock_memory("oformlenie_schorsa")
    "Ты замечаешь сообщение от Саши и решаешь ответить начальнику чуть-чуть позже."
    sasha "Прежде чем мы продолжим — как бы ты сформулировал главный вывод? Догадку? Своими словами. Что у тебя на уме?"
    window hide
    $ user_reflection = renpy.input("Твой вывод:", length=280).strip()

    python:
        t = user_reflection.lower().replace("ё", "е")

        # звучит как «закрыть тему», а значит «продолжать»
        neg_dis = ["не закры", "нельзя закры", "нельзя забы", "не забы", "не стоит закры",
                   "не надо закры", "не нужно закры", "не случайн", "неслучайн", "нельзя списы"]
        # содержит слово про проверку, а значит «бросить»
        dis_phr = ["не буду коп", "не будем коп", "не стоит коп", "не надо коп", "не нужно коп",
                   "не буду провер", "не будем провер", "не стоит провер", "не надо провер",
                   "не нужно провер", "нет смысла", "бессмысленно", "зачем коп", "зачем провер"]

        investigative = ["расслед", "провер", "аудит", "разобр", "разбер", "выяс", "докоп", "копа",
                         "копн", "изуч", "исслед", "сомн", "подозр", "скрыва", "скрыт", "прячет",
                         "прячут", "странн", "доступ", "продолж", "узна", "правд", "что-то не так",
                         "тут не так"]
        careful = ["поспеш", "преждевремен", "не хватает", "недостаточно", "больше данных",
                   "мало данных", "неясно", "не ясно", "непонятно", "не понятно", "не уверен",
                   "гипотез", "корреляц", "причинн", "не доказ", "не означает"]
        dismissive = ["закры", "неважн", "не важн", "не имеет значения", "ерунд", "пустяк", "мелоч",
                      "ничего страшного", "ничего не значит", "случайн", "совпадени", "забы", "забей",
                      "оставить как есть", "оставим", "проще", "ошибка в уч", "ошибка уч",
                      "ошибка в данн", "ошибка выгруз"]

        has_inv = False
        has_dis = False
        for p in neg_dis:
            if p in t:
                has_inv = True
                t = t.replace(p, " ")
        for p in dis_phr:
            if p in t:
                has_dis = True
                t = t.replace(p, " ")
        has_inv = has_inv or any(w in t for w in investigative)
        has_car = any(w in t for w in careful)
        has_dis = has_dis or any(w in t for w in dismissive)

        if user_reflection == "":
            refl_kind = "empty"
        elif has_dis and not (has_inv or has_car):
            refl_kind = "dismissive"
        elif has_inv and not has_dis:
            refl_kind = "investigative"
        elif has_car and not has_dis:
            refl_kind = "careful"
        else:
            refl_kind = "neutral"

    window show
    if refl_kind == "empty":
        player "..."
        "Слов не находится. Может, и не всё стоит облекать в слова."
    elif refl_kind == "investigative":
        player "[user_reflection]"
        boss "Настойчивый. Впрочем, я это уже понял про тебя."
        sasha "Похоже на тебя, коллега. Ты никогда не отпускаешь то, что не сходится."
    elif refl_kind == "careful":
        player "[user_reflection]"
        boss "ТЕКСТ: реплика босса на осторожный, честный вывод."
        sasha "ТЕКСТ: реплика Саши: умение сказать «пока не знаю» тоже навык."
    elif refl_kind == "dismissive":
        player "[user_reflection]"
        boss "Прагматично. Не самый смелый вывод, но хотя бы честный."
        sasha "Иногда проще жить, не заглядывая под каждый камень. Я тебя не сужу."
    else:
        player "[user_reflection]"
        sasha "Не знаю, что сказать... но, кажется, я тебя понимаю."
    window hide
    jump task3_final

# --- ФИНАЛ ---

label task3_final:
    window show
    if task3_outcome == "escalated":
        $ news_list.append("Жалоба сотрудника сети «Изобилие», направленная «выше по инстанции», по неподтверждённым данным, до сих пор находится на орбите.")
    elif task3_outcome == "retreated":
        $ news_list.append("Странности в работе одного из супермаркетов «Изобилие» проверяющие объяснили просто: «Всё в пределах нормы. Норма немного изменилась».")
    else:
        $ news_list.append("Совет директоров «Изобилия» шесть часов обсуждал «незначительную несостыковку». Слово «незначительную» с тех пор пишут в кавычках даже во внутренних документах.")

    $ news_list.extend([
        "Депутат предложил штрафовать за плохое настроение по понедельникам. Настроение улучшилось только у депутата.",
        "Городские фонари теперь светят через день — «чтобы люди не забывали, как выглядит темнота»."
    ])
    $ unread_news = True

    $ current_task = 4
    $ sasha_phase = 3

    "Ты возвращаешься к начальнику."
    boss "Думаю, твоё расследование окончено, аналитик. Скоро мы свяжемся с тобой в последний раз. Возможно, последний."
    "«Последний раз» звучит как-то особенно зловеще — отмечаешь ты про себя."
    player "Мы же ещё ни к чему толком не пришли."
    boss "Я — пришёл. Ко всему, что мне было нужно."

    window hide
    stop music fadeout 2.5
    hide image "images/scatter_correlation.png"
    scene black with Dissolve(1.2)
    pause 0.8

    show screen phase2_complete_screen
    pause 7.0
    hide screen phase2_complete_screen
    with Dissolve(1.0)
    pause 0.8

    if hq2_prediction_made and not hq2_confirmed:
        scene bg_terminal
        with Dissolve(1.0)
    call hq2_confirmation
    $ game_minutes_total += renpy.random.randint(20, 115)

    jump desktop_loop
