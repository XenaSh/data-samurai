init python:
    def mech_dots(results):
        out = []
        for i in range(4):
            if i < len(results):
                out.append("{color=#00ffcc}●{/color}" if results[i] else "{color=#ff6b6b}✕{/color}")
            else:
                out.append("{color=#6b7f8c}○{/color}")
        return " ".join(out)

screen mech_view(results, picked=None, correct=None):
    zorder 40

    for idx, key in enumerate(mech_layout):
        fixed:
            xpos 60 + idx * 460
            ypos 30
            xsize 420
            ysize 670
            add Solid("#0a0f1acc") xsize 420 ysize 600
            add ("ill_" + key) at Transform(fit="contain", size=(400, 570)) xalign 0.5 ypos 15
            if picked is not None and key in (picked, correct):
                frame:
                    xalign 0.5
                    ypos 595
                    padding (18, 6)
                    background Solid("#0a0f1aee")
                    text mech_names[key] color ("#00ffcc" if key == correct else "#ff6b6b") size 24 outlines [(2, "#000000", 0, 0)]

    if picked is not None:
        for idx, key in enumerate(mech_layout):
            if key == picked or key == correct:
                use sig_frame(60 + idx * 460, 30, 420, 600, ("#00ffcc" if key == correct else "#ff6b6b"))

    frame:
        xalign 0.97
        ypos 670
        padding (24, 10)
        background Solid("#000000b3")
        hbox:
            spacing 16
            text "Босс понял:" size 30 color "#ffaa00"
            text mech_dots(results) font "DejaVuSans.ttf" size 40

screen mech_pick(desc, first=False):
    zorder 41
    modal True

    if first:
        text "ЛКМ чтобы выбрать схему для босса" size 26 color "#ffaa00" xalign 0.5 ypos 690 xmaximum 1500 at sig_fade_in(0.4, 0.8)

    frame:
        xalign 0.5
        ypos 745
        xmaximum 1500
        padding (28, 18)
        background Solid("#0a0f1acc")
        text desc size 24 color "#ffffff" xmaximum 1440

    for idx, key in enumerate(mech_layout):
        button:
            xpos 60 + idx * 460
            ypos 30
            xsize 420
            ysize 600
            background None
            hover_background Solid("#00ffcc33")
            action Return(key)

label mech_round(correct):
    $ desc = mech_story[correct]
    show screen mech_view(mech_results)
    if len(mech_results) == 0:
        with dissolve
    window show
    player "[desc]"
    window hide
    call screen mech_pick(desc, len(mech_results) == 0)
    $ picked = _return
    $ mech_ok = (picked == correct)
    $ mech_results.append(mech_ok)
    show screen mech_view(mech_results, picked, correct)
    window show
    $ boss_says = mech_boss_says[picked]
    $ hero_fix = mech_hero_fix[correct]
    boss "[boss_says]"
    if mech_ok:
        $ accuracy += 1
    else:
        player "[hero_fix]"
    return


